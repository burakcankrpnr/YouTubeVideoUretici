# MoneyPrinterTurbo / Global AI Animation Studio
# Copy to .env or set in the environment. Never commit real secrets.

# Optional override for runtime data directory (config, storage, studio DB)
# MPT_HOME=

# Studio defaults
STUDIO_DEFAULT_TIMEZONE=Europe/Istanbul
APP_URL=http://localhost:8501

# YouTube Data API OAuth (official upload/scheduling)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8501

# Optional dedicated studio provider keys (reuse MPT config.toml when empty)
AI_TEXT_PROVIDER=
AI_TEXT_API_KEY=
AI_IMAGE_PROVIDER=
AI_IMAGE_API_KEY=
AI_VIDEO_PROVIDER=
AI_VIDEO_API_KEY=
AI_TTS_PROVIDER=
AI_TTS_API_KEY=
AI_AUDIO_PROVIDER=
AI_AUDIO_API_KEY=

# Object storage (future / optional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis (optional — studio SQLite queue works without Redis)
REDIS_URL=
